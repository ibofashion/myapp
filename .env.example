# Copier ce fichier en ".env" et renseigner les valeurs reelles.
# Ne jamais committer le fichier ".env" (voir .gitignore).

# --- Django core ---
# Generer avec: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
# Liste separee par des virgules, ex: "localhost,127.0.0.1,monapp.up.railway.app"
ALLOWED_HOSTS=localhost,127.0.0.1
# Requis par Django si DEBUG=False, ex: "https://monapp.up.railway.app"
CSRF_TRUSTED_ORIGINS=

# --- Base de donnees (PostgreSQL) ---
# Railway fournit automatiquement cette variable pour le service Postgres attache.
# En local, pointer vers une instance Postgres locale.
DATABASE_URL=postgres://user:password@localhost:5432/myapp

# --- Devise ---
# XOF (franc CFA) - montants entiers, sans sous-unite (voir ARCHITECTURE.md #1)
CURRENCY=XOF
